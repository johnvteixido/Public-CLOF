# Client Lead & Outreach Finder - server environment
# Copy to .env.local for local development. Configure these as server-only
# variables in Vercel for production. Never prefix secrets with VITE_.

# Owner-only application access
APP_URL=http://localhost:3000
# Unique password, at least 16 characters.
APP_ACCESS_PASSWORD=
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Server-only HMAC key, at least 32 characters.
APP_SESSION_SECRET=

# Grounded public-source discovery
GEMINI_API_KEY=

# Writing model via Vercel AI Gateway
AI_GATEWAY_MODEL=inclusionai/ling-3.1-flash-free
AI_GATEWAY_API_KEY=

# Neon PostgreSQL, server-side only
DATABASE_URL=

# Optional Gmail OAuth sending
# Google OAuth redirect URI: APP_URL/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# AES-256-GCM key: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_DAILY_CAP=80
